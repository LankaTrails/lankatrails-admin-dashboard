# Copy to .env (git-ignored). Dev server runs on http://localhost:5173.

# Backend REST API base URL (falls back to http://localhost:8080/api)
VITE_API_BASE_URL=http://localhost:8080/api
# Backend origin serving uploaded files (/uploads/...). Defaults to VITE_API_BASE_URL without /api.
VITE_BASE_URL=http://localhost:8080
